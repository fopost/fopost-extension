{
  "name": "fopost-extension",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "FoPost browser extension for Chrome and Firefox: capture any page, image, or link into a scheduled social post, and publish content to platforms with no write API (Substack).",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fopost/fopost-extension.git"
  },
  "homepage": "https://fopost.com",
  "bugs": {
    "url": "https://github.com/fopost/fopost-extension/issues"
  },
  "scripts": {
    "dev": "vite",
    "dev:firefox": "EXT_TARGET=firefox vite",
    "build": "tsc --noEmit && npm run build:chrome && npm run build:firefox",
    "build:chrome": "vite build",
    "build:firefox": "EXT_TARGET=firefox vite build",
    "start:firefox": "web-ext run --source-dir=dist/firefox",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "lint:firefox": "web-ext lint --source-dir=dist/firefox --self-hosted",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "zip": "npm run zip:chrome && npm run zip:firefox",
    "zip:chrome": "cd dist/chrome && zip -r ../../fopost-extension-chrome.zip .",
    "zip:firefox": "cd dist/firefox && zip -r ../../fopost-extension-firefox.zip ."
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.6.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.26",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.4.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vite": "^6.0.7",
    "vitest": "^3.2.7",
    "web-ext": "^10.6.0"
  },
  "engines": {
    "node": ">=22"
  }
}
